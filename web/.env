# Authentication
AUTH_SECRET=your-secret-key-minimum-32-characters-long-for-production

# SignalWire Agent Backend URL (local Python server)
AGENT_BACKEND_URL=http://localhost:8000

# Public URL for the application (optional override, auto-detected if not set)
# NOTE: The primary APP_DOMAIN is configured in agent/.env
# The Python backend reads it from there and writes it to agent-credentials.json
# The frontend then reads it from agent-credentials.json
# Only set NEXT_PUBLIC_APP_URL if you need to override the behavior
# Example: NEXT_PUBLIC_APP_URL=https://your-custom-domain.com
NEXT_PUBLIC_APP_URL=

# CORS Origins (comma-separated list of allowed origins)
# Example: CORS_ORIGINS=https://example.com,https://another.com
CORS_ORIGINS=

# Database
DATABASE_URL=postgresql://localhost/sally_sales

# NOTE: SWML Authentication Credentials
# The SWML webhook username and password are configured in agent/.env
# They are embedded in the webhook URL sent to SignalWire
# Format: https://username:password@domain/api/swml
