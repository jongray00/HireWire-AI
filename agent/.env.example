# SignalWire SWML Basic Authentication Credentials
# These credentials will be used for authenticating SWML webhook calls
# They will be embedded in the webhook URL sent to SignalWire
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=your-secure-password-here

# Application Domain
# This is the public URL where your application is hosted
# Do NOT include trailing slash
# Examples:
#   - Replit: https://your-repl-name.your-username.repl.co
#   - ngrok: https://your-subdomain.ngrok.io
#   - Production: https://your-domain.com
APP_DOMAIN=https://your-replit-url.replit.dev

# Agent Configuration
AGENT_PORT=8000
LOG_LEVEL=INFO
