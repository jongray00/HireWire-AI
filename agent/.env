# SignalWire SWML Basic Authentication Credentials
# These credentials will be used for authenticating SWML webhook calls
# They will be embedded in the webhook URL sent to SignalWire
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=<REDACTED-LEGACY-SWML-PASSWORD>

# Application Domain
# APP_DOMAIN is auto-detected from ngrok at startup.
# Set this manually only if not using ngrok or to override.
# APP_DOMAIN=https://your-domain.com
